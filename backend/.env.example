# Copien este archivo como .env (el .env NO se sube a Git).

# --- SQL Server local ---
# Instancia predeterminada: DB_SERVER=localhost y DB_PORT=1433.
# Instancia con nombre (p. ej. MSSQLSERVER01): dejen DB_PORT vacío y pongan DB_INSTANCE;
# en ese caso el servicio "SQL Server Browser" debe estar iniciado.
DB_SERVER=localhost
DB_PORT=1433
DB_INSTANCE=
DB_NAME=PetShopNova

# Login de mínimo privilegio creado al final de sql/03_procedimientos.sql.
# Si cambian la contraseña allá, cámbienla aquí también.
DB_USER=app_petshop
DB_PASSWORD=Cambiar_Esta_Clave_2026!

# --- API ---
# 4000 por defecto. Con PORT=80 la página queda en
# http://petshopnova.localhost (ver README, sección 6.1).
PORT=4000
# Cadena larga y aleatoria para firmar los tokens de sesión.
JWT_SECRET=cambien-esta-cadena-por-una-larga-y-aleatoria
JWT_EXPIRA=8h
# Origen del frontend en desarrollo (Vite).
CORS_ORIGIN=http://localhost:3000
